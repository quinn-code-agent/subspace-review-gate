@media(max-width:800px){.layout,.layout.float,.layout.min{display:block}.layout aside{display:none}main,.layout.float main,.layout.min main{padding:32px 22px;border:0}.question{font-size:30px}.annotation-toolbar,.composer{display:none!important}.mobile-comment-action{display:none;position:fixed;z-index:13;left:16px;right:16px;bottom:16px;border:0;border-radius:12px;background:#17212b;color:#fff;padding:15px;font-weight:700}.mobile-comment-action.ready{display:block}.mobile-sheet-backdrop.open{display:block;position:fixed;z-index:14;inset:0;background:#14203377}.composer.mobile-sheet{display:block!important;position:fixed;z-index:15;left:0!important;bottom:0;top:auto!important;transform:none;width:100%;max-width:none;border-radius:18px 18px 0 0;padding:22px 20px 26px}.composer.mobile-sheet textarea{min-height:112px}}
</style><div class="layout" id=layout><main><p class=revision>Immutable artifact · __REV__</p><h1 class=question>__QUESTION__</h1>__CONTENT__</main><aside><div class=rail-head><span class=rail-title>Feedback</span><button class=count id=comment-count>0</button></div><div class=rail-body><div class="identity-chip" id=identity-chip><i class=identity-dot id=identity-dot></i><div><div class=identity-name id=identity-name-display>Not set</div><div class=identity-portable id=identity-current>person:&lt;name&gt;</div></div><button class=change id=identity-edit>Change</button></div><div class=rail-actions><button id=shared>Show team feedback</button><button data-mode=fixed>Fixed</button><button data-mode=float>Float</button><button data-mode=min>Minimize</button></div><div id=team hidden></div><div id=comments><p><small>Select text to add an anchored comment.</small></p></div><textarea id=note placeholder="Optional overall note"></textarea><p><button class="save" id=send>Send Subspace Result</button></p><small id=status>Feedback-only; no Resolution or workflow action.</small></div></aside></div><div class="annotation-toolbar" id=annotation-toolbar><button id=clear>Clear</button><button class=primary id=comment>Comment</button></div><button class=mobile-comment-action id=mobile-comment-action>Comment on selection</button><div class=mobile-sheet-backdrop id=mobile-sheet-backdrop></div><section class=composer id=composer><div class=quote id=quote></div><textarea id=body placeholder="What should change?"></textarea><div class=actions><button class=cancel id=cancel>Cancel</button><button class=save id=add>Add annotation</button></div></section><div class=overlay id=identity-cover><div class=identity-card><h2>Who is reviewing?</h2><p>Enter your name once. You can change it later in Feedback.</p><input id=identity-name placeholder=KC autocomplete=name><p id=identity-preview>Will submit as person:&lt;name&gt;</p><button id=identity-confirm>Continue to review</button></div></div><di