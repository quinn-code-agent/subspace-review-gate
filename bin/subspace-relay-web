#!/usr/bin/env python3
"""Relay-backed Subspace Web reviewer. Uses no Human Review wire protocol."""
import argparse, hashlib, html, json, os, re, subprocess, sys, webbrowser
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
ROOT=Path(__file__).resolve().parents[1]; RELAY=ROOT/'bin'/'subspace-review-relay'
def run(*args):
 r=subprocess.run([sys.executable,str(RELAY),*args],text=True,capture_output=True)
 if r.returncode: raise RuntimeError(r.stderr.strip() or 'Relay adapter failed')
 return json.loads(r.stdout)
def page(briefing, raw, media):
 a=briefing['artifacts'][0]; q=html.escape(briefing['question'])
 content='<article id="artifact" class="markdown-content">Loading document…</article>' if media=='text/markdown' else f"<div id=artifact>{raw}</div>"
