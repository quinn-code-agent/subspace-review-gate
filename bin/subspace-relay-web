</script>__RENDERER__'''
 return t.replace('__REV__',html.escape(a['rev'])).replace('__QUESTION__',q).replace('__CONTENT__',content).replace('__RENDERER__',renderer).replace('__SOURCE__',json.dumps(raw).replace('</','<\\/'))
def owner_results(briefing_id,endpoint,state): return run('results','--briefing',briefing_id,'--endpoint',endpoint,'--state-dir',str(state))
def shared_annotations(briefing_id,endpoint,state):
 out=[]; root=state/briefing_id/'shared'
 for summary in owner_results(briefing_id,endpoint,state).get('results',[]):
  rid=summary.get('resultId');
  if not rid: continue
  pulled=root/rid; run('pull-result','--briefing',briefing_id,'--result-id',rid,'--output-dir',str(pulled),'--endpoint',endpoint,'--state-dir',str(state)); result=json.loads((pulled/'result.json').read_text())
  for a in result.get('annotations',[]):
   if a.get('type')=='Annotation':
    sel=a.get('selectors') or []; out.append({'by':a.get('by','unknown'),'quote':sel[0].get('exact','') if sel and isinstance(sel[0],dict) else '','body':a.get('body','')})
 return out
def reviewer_state(root,reviewer):
 if not re.fullmatch(r'person:[A-Za-z0-9._@-]{1,128}',reviewer): raise ValueError('reviewer must use person:<stable-name>')
 return root/'reviewers'/hashlib.sha256(reviewer.encode()).hexdigest()[:24]
def main():
 p=argparse.ArgumentParser(description='Relay-backed Subspace Web reviewer (feedback-only; no Human Review protocol).');p.add_argument('open',nargs='?');p.add_argument('--briefing',required=True);p.add_argument('--endpoint',default='https://subspace-relay-staging.netlify.app');p.add_argument('--state-dir');p.add_argument('--owner-state-dir');p.add_argument('--shared-feedback',action='store_true');p.add_argument('--port',type=int,default=0);p.add_argument('--no-browser',action='store_true');args=p.parse_args()
 if args.open!='open': p.error('expected: open')
 state=Path(args.state_dir).resolve() if args.state_dir else Path(os.environ.get('HERMES_HOME',Path.home()/'.hermes'))/'subspace-review-gate'/'web'; owner=Path(args.owner_state_dir).resolve() if args.owner_state_dir else Path(os.environ.get('HERMES_HOME',Path.home()/'.hermes'))/'subspace-review-gate'/'relay'; package=state/args.briefing/'package';run('fetch','--briefing',args.briefing,'--endpoint',args.endpoint,'--output-dir',str(package)); briefing=json.loads((package/'briefing.json').read_text());artifact=briefing['artifacts'][0];raw=(package/artifact['uri']).read_text()
 class Handler(BaseHTTPRequestHandler):
  def log_message(self,*_): pass
  def do_GET(self):
   if self.path=='/api/shared-feedback':
    if not args.shared_feedback:self.send_error(403,'Team feedback is currently hidden by the owner.');return
    try: body=json.dumps({'annotations':shared_annotations(args.briefing,args.endpoint,owner)}).encode();self.send_response(200);self.send_header('Content-Type','application/json');self.send_header('Cache-Control','no-store');self.send_header('Content-Length',str(len(body)));self.end_headers();self.wfile.write(body)
    except Exception as e: body=json.dumps({'error':str(e)}).encode();self.send_response(502);self.send_header('Content-Type','application/json');self.send_header('Content-Length',str(len(body)));self.end_headers();self.wfile.write(body)
    return
   if self.path!='/':self.send_error(404);return
   body=page(briefing,raw,artifact['mediaType']).encode();self.send_response(200);self.send_header('Content-Type','text/html; charset=utf-8');self.send_header('Content-Length',str(len(body)));self.end_headers();self.wfile.write(body)
  def do_POST(self):
   if self.path!='/api/submit':self.send_error(404);return
   try:
    data=json.loads(self.rfile.read(int(self.headers['Content-Length'])));reviewer=data.get('reviewer','');root=reviewer_state(state/args.briefing,reviewer);feedback={'comments':data.get('comments',[]),'overall_note':data.get('overall_note','')};fp=root/'feedback.json';fp.parent.mkdir(parents=True,exist_ok=True);fp.write_text(json.dumps(feedback));review=root/'review.jsonl';result=root/'result.json';run('annotations','--briefing',str(package/'briefing.json'),'--feedback',str(fp),'--reviewer',reviewer,'--output',str(review));run('build-feedback-result','--briefing',str(package/'briefing.json'),'--review',str(review),'--actor',reviewer,'--output',str(result));sub=run('submit','--briefing',args.briefing,'--review',str(review),'--result',str(result),'--endpoint',args.endpoint,'--state-dir',str(root));body=json.dumps({'result_id':sub['result_id']}).encode();self.send_response(201);self.send_header('Content-Type','application/json');self.send_header('Content-Length',str(len(body)));self.end_headers();self.wfile.write(body)
   except Exception as e:body=json.dumps({'error':str(e)}).encode();self.send_response(400);self.send_header('Content-Type','application/json');self.send_header('Content-Length',str(len(body)));self.end_headers();self.wfile.write(body)
 s=ThreadingHTTPServer(('127.0.0.1',args.port),Handler);url=f'http://127.0.0.1:{s.server_port}/';print(json.dumps({'ok':True,'url':url,'briefing':args.briefing,'mode':'feedback'}),flush=True)
 if not args.no_browser:webbrowser.open(url)
 s.serve_forever()
if __name__=='__main__':main()
