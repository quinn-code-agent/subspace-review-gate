const $=id=>document.getElementById(id),mobile=matchMedia('(max-width:800px)'),identityKey='subspace-reviewer-name-v1',railKey='subspace-rail-mode-v1';let comments=[],quote='',range=null,draftRange=null,rect=null,savedRanges=[],lastMode=localStorage.getItem(railKey)||'fixed';function esc(s){const d=document.createElement('div');d.textContent=s;return d.innerHTML}function norm(n){const s=n.trim().toLowerCase().replace(/\\s+/g,'-').replace(/[^a-z0-9._@-]/g,'').replace(/-+/g,'-').replace(/^-|-$/g,'');return s?'person:'+s:''}function color(id){let h=2166136261;for(const c of id){h^=c.charCodeAt(0);h=Math.imul(h,16777619)}return `hsl(${Math.abs(h)%360} 68% 44%)`}function setIdentity(n){const id=norm(n);if(!id){$('identity-preview').textContent='Enter a name using letters or numbers.';return false}localStorage.setItem(identityKey,n.trim());$('identity-name-display').textContent=n.trim();$('identity-current').textContent=id;$('identity-dot').style.background=color(id);$('identity-cover').hidden=true;return true}function showIdentity(){$('identity-name').value=localStorage.getItem(identityKey)||'';$('identity-preview').textContent=$('identity-name').value?'Will submit as '+norm($('identity-name').value):'Will submit as person:<name>';$('identity-cover').hidden=false;$('identity-name').focus()}$('identity-name').oninput=e=>$('identity-preview').textContent=norm(e.target.value)?'Will submit as '+norm(e.target.value):'Will submit as person:<name>';$('identity-confirm').onclick=()=>setIdentity($('identity-name').value);$('identity-edit').onclick=showIdentity;const existing=localStorage.getItem(identityKey);if(existing)setIdentity(existing);else showIdentity();function mode(m){if(m!=='min')lastMode=m;$('layout').className='layout '+m;localStorage.setItem(railKey,m)}document.querySelectorAll('[data-mode]').forEach(b=>b.onclick=()=>mode(b.dataset.mode));mode(lastMode);$('comment-count').onclick=()=>mode(lastMode);function selected(){const s=getSelection();const candidate=s.rangeCount?s.getRangeAt(0).cloneRange():null;if(!candidate||!s.toString().trim()||!artifact.contains(candidate.commonAncestorContainer)){if(!draftRange){$('annotation-toolbar').style.display='none';$('mobile-comment-action').classList.remove('ready')}return}quote=s.toString().trim();range=candidate;rect=range.getBoundingClientRect();if(mobile.matches)$('mobile-comment-action').classList.add('ready');else{const t=$('annotation-toolbar');t.style.left=(rect.left+rect.width/2)+'px';t.style.top=(rect.top+scrollY)+'px';t.style.display='flex'}}document.addEventListener('mouseup',()=>setTimeout(selected));document.addEventListener('touchend',()=>setTimeout(selected,180));document.addEventListener('selectionchange',()=>{if(mobile.matches)setTimeout(selected,80)});function clearDraft(){CSS.highlights?.delete('subspace-draft');draftRange=null}function renderHighlights(){if(!CSS.highlights)return;CSS.highlights.delete('subspace-saved');if(savedRanges.length)CSS.highlights.set('subspace-saved',new Highlight(...savedRanges))}function close(discard=true){if(discard)clearDraft();$('annotation-toolbar').style.display='none';$('composer').style.display='none';$('composer').classList.remove('mobile-sheet');$('mobile-sheet-backdrop').classList.remove('open');$('mobile-comment-action').classList.remove('ready')}function compose(){if(!range)return;draftRange=range.cloneRange();if(CSS.highlights)CSS.highlights.set('subspace-draft',new Highlight(draftRange));$('quote').textContent='“'+quote.slice(0,180)+(quote.length>180?'…':'')+'”';if(mobile.matches){$('composer').classList.add('mobile-sheet');$('mobile-sheet-backdrop').classList.add('open')}else{const c=$('composer');c.style.left=(rect.left+rect.width/2)+'px';c.style.top=(rect.bottom+scrollY)+'px';c.style.display='block';$('annotation-toolbar').style.display='none'}$('body').focus()}$('comment').onclick=compose;$('mobile-comment-action').onclick=compose;$('clear').onclick=()=>{getSelection().removeAllRanges();close()};$('cancel').onclick=close;